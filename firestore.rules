rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuth() && request.auth.token.role == 'admin';
    }

    function isAlumni() {
      return isAuth() && request.auth.token.role == 'alumni';
    }

    // ── Users ──────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:  if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();

      // Profile sub-document
      match /profile/data {
        allow read:  if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }

      // Notification read status
      match /notifStatus/{notifId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ── Jobs ───────────────────────────────────────────────────────
    match /jobs/{jobId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();

      // Applicants subcollection
      match /applicants/{userId} {
        // Alumni can write their own entry; admins can read all
        allow create: if isOwner(userId);
        allow read:   if isOwner(userId) || isAdmin();
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
    }

    // ── Events ─────────────────────────────────────────────────────
    match /events/{eventId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();

      // Attendees subcollection
      match /attendees/{userId} {
        allow create: if isOwner(userId);
        allow read:   if isOwner(userId) || isAdmin();
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
    }

    // ── Notifications ──────────────────────────────────────────────
    match /notifications/{notifId} {
      // Alumni can read notifs addressed to them or "all"
      allow read: if isAuth() && (
        resource.data.recipientId == request.auth.uid ||
        resource.data.recipientId == 'all'
      );
      // Written server-side via Admin SDK (bypasses rules) or by admin users
      allow write: if isAdmin();
    }

    // ── Departments ────────────────────────────────────────────────
    match /departments/{deptId} {
      allow read: if true;          // Public for signup form
      allow write: if isAdmin();
    }
  }
}
